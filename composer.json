{
    "name": "metaseller/tinkoff-invest-api-v2-yii2",
    "version": "0.3.0",
    "description": "Yii2 framework wrapper for unofficial PHP SDK for Tinkoff Invest API v2",
    "type": "library",
    "license": "Apache-2.0",
    "keywords": [
        "php",
        "tinkoff",
        "t-bank",
        "invest api",
        "t-invest",
        "t-investments",
        "invest api sdk",
        "Yii2 framework",
        "Yii2 wrapper",
        "yii2"
    ],
    "homepage": "https://github.com/metaseller/tinkoff-invest-api-v2-yii2",
    "authors": [
        {
            "name": "Igor Frolenkov",
            "email": "igor@frolenkov.ru"
        }
    ],
    "minimum-stability": "stable",
    "require": {
        "php": "^8.5.12",
        "ext-grpc": "^1.83.1",
        "metaseller/tinkoff-invest-api-v2-php": "^0.6.0",
        "yiisoft/yii2": "^2.0.55"
    },
    "autoload": {
        "psr-4": {
            "Metaseller\\yii2TinkoffInvestApi2\\": "src"
        }
    },
    "config": {
        "allow-plugins": {
            "yiisoft/yii2-composer": true
        },
        "platform": {
            "php": "8.5.12"
        },
        "sort-packages": true
    },
    "repositories": [
        {
            "type": "composer",
            "url": "https://asset-packagist.org"
        }
    ],
    "scripts": {
        "test": "@php -d error_reporting=E_ALL tests/compatibility.php"
    }
}
